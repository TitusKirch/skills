{
  "language": "en",
  "verify": "pnpm check",
  "commit": { "scopeVocab": ["alpha", "beta"] },
  "pr": { "base": "dev" },
  "release": { "promote": "auto" },
  "work": {
    "branch": "branch:dev",
    "cap": 10,
    "labels": {
      "ready": "ai: ready",
      "reviewRequested": "ai: review requested",
      "done": "ai: done"
    }
  },
  "profiles": {
    "ci": {
      "work": { "branch": "worktree", "labels": { "ready": "ci: queued" } },
      "release": false
    },
    "audit": {
      "commit": { "scopeVocab": ["only-this"] },
      "verify": null
    }
  }
}
