{
  "$schema": "https://raw.githubusercontent.com/TitusKirch/skills/main/tituskirch-skills.schema.json",
  "language": "en",
  "verify": "pnpm check",
  "commit": {
    "scopeVocab": [
      "atomic-commit",
      "compact-readme",
      "handoff",
      "issue",
      "merge-deps",
      "prune-branches",
      "prune-comments",
      "pull-request",
      "release",
      "tituskirch-skills-config",
      "update-deps",
      "vhs-demo",
      "work-implement",
      "work-implement-queue",
      "work-review",
      "work-review-queue",
      "write-docs",
      "write-readme",
      "skills",
      "deps",
      "deps-dev",
      "dependabot",
      "changelog",
      "ci"
    ]
  },
  "pr": {
    "base": "dev"
  },
  "release": {
    "promote": "auto"
  },
  "issue": {
    "tracker": "github",
    "title": {
      "convention": "plain"
    },
    "labels": {
      "exclude": ["stack:*", "autorelease:*", "dependencies"]
    }
  },
  "docs": {
    "preset": "ai-tool",
    "instructions": "Skills are self-documenting in place (SKILL.md / REFERENCE.md / DESIGN.md per skill); reserve docs/ for cross-cutting guides and ADRs — concise and example-first."
  },
  "work": {
    "branch": "branch:dev",
    "labels": {
      "ready": "ai: ready",
      "working": "ai: working",
      "review": "ai: review",
      "changesRequested": "ai: changes requested",
      "needsHuman": "ai: needs human",
      "done": "ai: done",
      "blocked": "ai: blocked"
    },
    "priorityLabels": [
      "priority: urgent",
      "priority: high",
      "priority: medium",
      "priority: low"
    ]
  }
}
