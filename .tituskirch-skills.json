{
  "$schema": "https://raw.githubusercontent.com/TitusKirch/skills/main/tituskirch-skills.schema.json",
  "forge": "github",
  "grillWith": "grilling",
  "language": "en",
  "verify": "pnpm verify",
  "trustedBots": [
    {
      "id": 287319172,
      "login": "kirchdev-release[bot]"
    },
    {
      "id": 49699333,
      "login": "dependabot[bot]"
    }
  ],
  "commit": {
    "language": "en",
    "scopes": "auto",
    "scopeVocab": [
      "atomic-commit",
      "compact-readme",
      "handoff",
      "issue",
      "merge-deps",
      "prune-branches",
      "prune-comments",
      "pull-request",
      "refine-issue",
      "release",
      "tituskirch-skills-config",
      "tldr",
      "update-deps",
      "validate-skills",
      "vhs-demo",
      "work-implement",
      "work-implement-queue",
      "work-review",
      "work-review-queue",
      "write-contributing",
      "write-docs",
      "write-readme",
      "skills",
      "deps",
      "deps-dev",
      "dependabot",
      "changelog",
      "ci"
    ]
  },
  "pr": {
    "base": "dev",
    "title": {
      "convention": "conventional"
    }
  },
  "release": {
    "promote": "auto",
    "stages": ["dev", "main"],
    "timeout": 600
  },
  "mergeDeps": {
    "merge": "grouped"
  },
  "pruneBranches": {
    "age": 90,
    "protect": []
  },
  "issue": {
    "tracker": "github",
    "title": {
      "convention": "plain"
    },
    "labels": {
      "exclude": ["stack:*", "autorelease:*", "dependencies"]
    }
  },
  "docs": {
    "preset": "package",
    "instructions": "Skills are self-documenting in place (SKILL.md / REFERENCE.md / DESIGN.md per skill); reserve docs/ for cross-cutting guides and ADRs — concise and example-first."
  },
  "work": {
    "tracker": "github",
    "cap": 10,
    "branch": "branch:dev",
    "parallel": false,
    "labels": {
      "ready": "ai: ready",
      "working": "ai: working",
      "reviewRequested": "ai: review requested",
      "reviewing": "ai: reviewing",
      "changesRequested": "ai: changes requested",
      "needsHuman": "ai: needs human",
      "done": "ai: done",
      "blocked": "ai: blocked",
      "repo": false,
      "needsTriage": "needs triage"
    },
    "review": {
      "maxRounds": 3
    },
    "priorityLabels": [
      "priority: urgent",
      "priority: high",
      "priority: medium",
      "priority: low"
    ]
  },
  "profiles": {
    "worktree": {
      "work": {
        "branch": "worktree",
        "parallel": true,
        "queueBranch": true
      }
    }
  }
}
