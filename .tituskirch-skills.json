{
  "$schema": "https://raw.githubusercontent.com/TitusKirch/skills/main/tituskirch-skills.schema.json",
  "language": "en",
  "commit": {
    "scopeVocab": [
      "atomic-commit",
      "compact-readme",
      "handoff",
      "issue",
      "merge-deps",
      "pull-request",
      "release",
      "tituskirch-skills-config",
      "update-deps",
      "vhs-demo",
      "work-issue",
      "work-queue",
      "write-docs",
      "write-readme",
      "skills",
      "deps",
      "deps-dev",
      "dependabot",
      "changelog",
      "ci"
    ]
  },
  "pr": {
    "base": "dev"
  },
  "release": {
    "promote": "auto"
  },
  "issue": {
    "tracker": "github",
    "title": { "convention": "plain" },
    "labels": { "exclude": ["stack:*", "autorelease:*", "dependencies"] }
  },
  "docs": {
    "preset": "ai-tool"
  },
  "work": {
    "branch": "branch:dev",
    "verify": "pnpm check",
    "labels": {
      "ready": "ai: ready",
      "working": "ai: working",
      "review": "ai: review",
      "done": "ai: done",
      "blocked": "ai: blocked"
    },
    "priorityLabels": [
      "priority: urgent",
      "priority: high",
      "priority: medium",
      "priority: low"
    ]
  }
}
