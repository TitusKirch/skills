{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@tituskirch/skills",
  "version": "0.3.0",
  "description": "Agent skills by Titus Kirch — installable via skills.sh in Claude Code, Cursor, Windsurf and friends.",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "claude-code",
    "cursor",
    "kirchdev",
    "llm",
    "prompt-engineering",
    "skills",
    "windsurf"
  ],
  "homepage": "https://github.com/TitusKirch/skills#readme",
  "bugs": {
    "url": "https://github.com/TitusKirch/skills/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TitusKirch/skills.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check": "pnpm lint && pnpm format",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "typecheck": "tsc",
    "test": "node --test 'test/*.test.ts'",
    "taze": "taze",
    "taze:w": "taze -w",
    "skills:list": "bash scripts/list-skills.sh",
    "skills:link": "bash scripts/link-skills.sh",
    "skills:unlink": "bash scripts/unlink-skills.sh",
    "skills:sync": "node scripts/gen-skills.ts",
    "skills:check": "node scripts/gen-skills.ts --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "taze": "^19.15.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2"
}
